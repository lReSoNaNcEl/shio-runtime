HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

ASR_PROVIDER=cuda
WHISPER_MODEL=medium
WHISPER_MODEL_REVISION=08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_LANGUAGE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_DEFAULT_ENGINE=f5
VOICE_MANIFEST_PATH=./voice_manifest.json
EMOTION_MANIFEST_PATH=./emotion_manifest.json
VOICE_SYNC_MAX_VOICES=10
VOICE_REPOSITORY_STATUS_PATH=./voice_repository_status.json
# Optional override. Empty uses the commit SHA pinned in voice_manifest.json.
VOICE_DATASET_REVISION=
HF_TOKEN=
F5_MODEL_ID=Misha24-10/F5-TTS_RUSSIAN
F5_MODEL_REVISION=ea166adeae4c80ec5ee423a671e2bdb83906cf84
F5_VOCODER_REVISION=0feb3fdd929bcd6649e0e7c5a688cf7dd012ef21
RUACCENT_MODEL_REVISION=b78ae5ea1e62beaf138bed1865cd8c3b0b5ca855
F5_CKPT_SUBPATH=F5TTS_v1_Base_v2/model_last_inference.safetensors
F5_VOCAB_SUBPATH=F5TTS_v1_Base/vocab.txt
F5_USE_ACCENT=true
F5_NFE_STEP=24
F5_CFG_STRENGTH=1.5
# Development/test only. The packaged Speech Pack uses .env.release with this disabled.
F5_ALLOW_MOCK=true

DEVICE=cuda
NUM_THREADS=4

EMOTIONS=neutral,calm,warm,happy,laugh,chuckle,sad,crying,angry,fear,surprised,gasp,sigh,groan,whisper

WARMUP_ON_STARTUP=true

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
