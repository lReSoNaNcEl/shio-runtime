{
  "name": "shio-runtime",
  "private": true,
  "version": "0.1.0-alpha.6",
  "description": "Monorepo root for the Shio runtime: Electron desktop client + local ASR/TTS speech service. Root only orchestrates existing per-project commands; the two apps stay independent and communicate solely over the HTTP API contract.",
  "scripts": {
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:pack": "npm --prefix apps/desktop run pack",
    "desktop:preview": "npm --prefix apps/desktop run preview",
    "desktop:start": "npm --prefix apps/desktop run start",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:lint": "npm --prefix apps/desktop run lint",
    "desktop:lint:fix": "npm --prefix apps/desktop run lint:fix",
    "desktop:format": "npm --prefix apps/desktop run format",
    "desktop:format:check": "npm --prefix apps/desktop run format:check",
    "desktop:imports": "npm --prefix apps/desktop run imports",
    "desktop:imports:check": "npm --prefix apps/desktop run imports:check",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:check:fix": "npm --prefix apps/desktop run check:fix",
    "desktop:security:repro": "npm --prefix apps/desktop run repro:desktop-security",
    "desktop:reliability:repro": "npm --prefix apps/desktop run repro:desktop-reliability",
    "desktop:speech-reliability:repro": "npm --prefix apps/desktop run repro:speech-reliability",
    "desktop:ui:repro": "npm --prefix apps/desktop run repro:desktop-ui-architecture",
    "desktop:architecture-ownership:repro": "npm --prefix apps/desktop run repro:architecture-ownership",
    "desktop:main-application-services:repro": "npm --prefix apps/desktop run repro:main-application-services",
    "desktop:network-diagnostics:repro": "npm --prefix apps/desktop run repro:network-diagnostics",
    "desktop:health:repro": "npm --prefix apps/desktop run repro:runtime-health",
    "desktop:character-capabilities:repro": "npm --prefix apps/desktop run repro:character-capability-awareness",
    "desktop:capabilities:repro": "npm --prefix apps/desktop run repro:capabilities",
    "desktop:streamdown:repro": "npm --prefix apps/desktop run repro:streamdown",
    "desktop:action-runtime:repro": "npm --prefix apps/desktop run repro:action-runtime",
    "desktop:action-verification:repro": "npm --prefix apps/desktop run repro:action-verification",
    "desktop:dsh:repro": "npm --prefix apps/desktop run repro:dsh",
    "desktop:browser-control:repro": "npm --prefix apps/desktop run repro:browser-control",
    "desktop:browser-control:qualification": "npm --prefix apps/desktop run qualify:browser-control",
    "desktop:browser-workflow:repro": "npm --prefix apps/desktop run repro:browser-workflow",
    "desktop:project-freshness:repro": "npm --prefix apps/desktop run repro:project-freshness",
    "desktop:project-evidence:repro": "npm --prefix apps/desktop run repro:project-evidence",
    "desktop:project-aware-actions:repro": "npm --prefix apps/desktop run repro:project-aware-actions",
    "desktop:semantic-character-tools:repro": "npm --prefix apps/desktop run repro:semantic-character-tools",
    "desktop:memory:repro": "npm --prefix apps/desktop run repro:memory",
    "desktop:alive-autonomy:repro": "npm --prefix apps/desktop run repro:alive-autonomy",
    "desktop:living-loop-hardening:repro": "npm --prefix apps/desktop run repro:living-loop-hardening",
    "desktop:living-presence-hardening:repro": "npm --prefix apps/desktop run repro:living-presence-hardening",
    "desktop:living-presence:soak": "npm --prefix apps/desktop run qualify:living-presence",
    "desktop:world-context:repro": "npm --prefix apps/desktop run repro:world-context",
    "desktop:mind-layer:repro": "npm --prefix apps/desktop run repro:mind-layer",
    "desktop:goal-runtime:repro": "npm --prefix apps/desktop run repro:goal-runtime",
    "desktop:memory-2:repro": "npm --prefix apps/desktop run repro:memory-2",
    "desktop:streaming-tts-2:repro": "npm --prefix apps/desktop run repro:streaming-tts-2",
    "desktop:latency-benchmark": "npm --prefix apps/desktop run benchmark:latency-30",
    "desktop:prompt-budget:repro": "npm --prefix apps/desktop run repro:prompt-budget",
    "desktop:web-search:repro": "npm --prefix apps/desktop run repro:web-search",
    "desktop:plugins:repro": "npm --prefix apps/desktop run repro:plugin-runtime",
    "desktop:avatar-visual-motion:repro": "npm --prefix apps/desktop run repro:avatar-visual-motion",
    "api:install": "node scripts/api-runner.mjs install",
    "api:install:dev": "node scripts/api-runner.mjs install-dev",
    "api:install:alpha": "node scripts/api-runner.mjs install-alpha",
    "api:voices:sync": "node scripts/api-runner.mjs voices-sync",
    "api:dev": "node scripts/api-runner.mjs dev",
    "api:start": "node scripts/api-runner.mjs start",
    "api:prefetch": "node scripts/api-runner.mjs prefetch",
    "api:lint": "node scripts/api-runner.mjs lint",
    "api:lint:fix": "node scripts/api-runner.mjs lint-fix",
    "api:format": "node scripts/api-runner.mjs format",
    "api:format:check": "node scripts/api-runner.mjs format-check",
    "api:test": "node scripts/api-runner.mjs test",
    "api:doctor": "node scripts/api-runner.mjs doctor",
    "api:doctor:strict": "node scripts/api-runner.mjs doctor-strict",
    "api:lock": "powershell -ExecutionPolicy Bypass -File scripts/lock-api-requirements.ps1",
    "alpha:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-alpha.ps1",
    "alpha:launcher:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-alpha-launcher.ps1",
    "alpha:integrity:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-alpha-release-integrity.ps1",
    "alpha:version:check": "node scripts/verify-alpha-version.mjs",
    "alpha:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-alpha-bundle.ps1",
    "alpha:bundle:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-alpha-bundle.ps1",
    "alpha:checksums": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-alpha-checksums.ps1",
    "build": "npm run desktop:build",
    "typecheck": "npm run desktop:typecheck",
    "test": "npm run api:test",
    "lint": "npm run desktop:lint && npm run api:lint",
    "lint:fix": "npm run desktop:lint:fix && npm run api:lint:fix",
    "format": "npm run desktop:format && npm run api:format",
    "format:check": "npm run desktop:format:check && npm run api:format:check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  }
}
