{
  "name": "shio-runtime",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo root for the Shio runtime: Electron desktop client + local ASR/TTS speech service. Root only orchestrates existing per-project commands; the two apps stay independent and communicate solely over the HTTP API contract.",
  "scripts": {
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:preview": "npm --prefix apps/desktop run preview",
    "desktop:start": "npm --prefix apps/desktop run start",
    "desktop:typecheck": "cd apps/desktop && npx tsc --noEmit",
    "api:install": "python -m pip install -r services/api/requirements.txt",
    "api:install:dev": "python -m pip install -r services/api/requirements-dev.txt",
    "api:voices:sync": "cd services/api && python scripts/sync_voices.py",
    "api:dev": "cd services/api && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "api:lint": "cd services/api && python -m ruff check .",
    "api:lint:fix": "cd services/api && python -m ruff check . --fix",
    "api:format": "cd services/api && python -m ruff format .",
    "api:format:check": "cd services/api && python -m ruff format --check .",
    "build": "npm run desktop:build",
    "typecheck": "npm run desktop:typecheck"
  }
}
