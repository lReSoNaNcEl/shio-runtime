HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

ASR_PROVIDER=cuda
WHISPER_MODEL=medium
WHISPER_MODEL_REVISION=08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_LANGUAGE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_DEFAULT_ENGINE=cosyvoice3
VOICE_MANIFEST_PATH=./voice_manifest.json
EMOTION_MANIFEST_PATH=./emotion_manifest.json
VOICE_SYNC_MAX_VOICES=10
VOICE_REPOSITORY_STATUS_PATH=./voice_repository_status.json
VOICE_CACHE_ROOT=./cache
# Optional override. Empty uses the commit SHA pinned in voice_manifest.json.
VOICE_DATASET_REVISION=
HF_TOKEN=
COSYVOICE_MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE_MODEL_REVISION=29e01c4e8d000f4bcd70751be16fa94bf3d85a18
COSYVOICE_SOURCE_REVISION=074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc
COSYVOICE_MATCHA_REVISION=dd9105b34bf2be2230f4aa1e4769fb586a3c824e
# Optional development overrides. Release uses the pinned SHIO_MODEL_ROOT layout.
COSYVOICE_SOURCE_PATH=
COSYVOICE_MODEL_PATH=
COSYVOICE_MAX_SESSIONS=1
COSYVOICE_MAX_SESSION_SECONDS=120

DEVICE=cuda
NUM_THREADS=4

EMOTIONS=neutral,calm,warm,happy,laugh,chuckle,sad,crying,angry,fear,surprised,gasp,sigh,groan,whisper

WARMUP_ON_STARTUP=true

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
