FISH_SOURCE_PATH=
FISH_MODEL_PATH=
FISH_MAX_SESSIONS=1
FISH_MAX_SESSION_SECONDS=120

FISH_COMPILE=true

DEVICE=cuda
NUM_THREADS=4


WARMUP_ON_STARTUP=true

