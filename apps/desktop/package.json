{
  "name": "shio-runtime-desktop",
  "version": "0.1.0-alpha.6",
  "description": "Desktop AI character runtime with local speech integration.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "repro:playback": "esbuild scripts/speech-playback-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/speech-playback-repro.cjs && node out/speech-playback-repro.cjs",
    "repro:speech-polish": "esbuild scripts/speech-polish-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/speech-polish-repro.cjs && node out/speech-polish-repro.cjs",
    "repro:speech-banner": "esbuild scripts/speech-banner-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/speech-banner-repro.cjs && node out/speech-banner-repro.cjs",
    "repro:invariants": "esbuild scripts/runtime-invariant-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/runtime-invariant-repro.cjs && node out/runtime-invariant-repro.cjs",
    "repro:ear": "esbuild scripts/ear-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/ear-repro.cjs && node out/ear-repro.cjs",
    "repro:embodiment-polish": "esbuild scripts/embodiment-polish-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/embodiment-polish-repro.cjs && node out/embodiment-polish-repro.cjs",
    "repro:structured-embodiment": "esbuild scripts/structured-embodiment-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/structured-embodiment-repro.cjs && node out/structured-embodiment-repro.cjs",
