{
  "name": "vtuber-app",
  "version": "1.0.0",
  "description": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "repro:playback": "esbuild scripts/speech-playback-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/speech-playback-repro/harness.cjs && node scripts/speech-playback-repro/harness.cjs",
    "repro:invariants": "esbuild scripts/runtime-invariant-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/runtime-invariant-repro/harness.cjs && node scripts/runtime-invariant-repro/harness.cjs",
    "repro:ear": "esbuild scripts/ear-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/ear-repro/harness.cjs && node scripts/ear-repro/harness.cjs",
    "repro:embodiment-polish": "esbuild scripts/embodiment-polish-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/embodiment-polish-repro/harness.cjs && node scripts/embodiment-polish-repro/harness.cjs",
    "repro:llm-compat": "esbuild scripts/llm-compat-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/llm-compat-repro/harness.cjs && node scripts/llm-compat-repro/harness.cjs",
    "repro:llm-live": "esbuild scripts/llm-live-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/llm-live-repro/harness.cjs && node scripts/llm-live-repro/harness.cjs",
    "repro:continuous-listening": "esbuild scripts/continuous-listening-repro/harness.ts --bundle --platform=node --format=cjs --outfile=scripts/continuous-listening-repro/harness.cjs && node scripts/continuous-listening-repro/harness.cjs",
    "repro:project-awareness": "esbuild scripts/project-awareness-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/project-awareness-repro.cjs && node out/project-awareness-repro.cjs",
    "repro:localization": "esbuild scripts/localization-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/localization-repro.cjs && node out/localization-repro.cjs",
    "test:llm-live": "npm run repro:llm-live"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@lezer/common": "^1.5.2",
    "@lezer/python": "^1.1.19",
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "@react-spectrum/s2": "^1.5.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  }
}
