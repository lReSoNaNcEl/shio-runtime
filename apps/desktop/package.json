{
  "name": "shio-runtime-desktop",
  "version": "0.1.0-alpha.6",
  "description": "Desktop AI character runtime with local speech integration.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:renderer": "vitest run tests/renderer",
    "test:architecture": "vitest run tests/architecture",
    "test:contracts": "vitest run tests/contracts",
    "test:fast": "vitest run tests/unit tests/contracts tests/architecture",
    "test:regression": "vitest run",
    "qualify:browser": "npm run qualify:browser-control",
    "qualify:browser-control": "esbuild qualifications/browser-control/qualify.ts --bundle --platform=node --format=esm --packages=external --outfile=out/browser-control-qualification.mjs && node out/browser-control-qualification.mjs",
    "qualify:continuous-browser": "esbuild src/main/browser-control/computer-use/browserReactiveTrackerWorker.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/continuous-browser-reactive-worker.cjs && esbuild qualifications/continuous-browser-control/qualify.ts --bundle --platform=node --format=esm --packages=external --outfile=out/continuous-browser-qualification.mjs && node out/continuous-browser-qualification.mjs",
    "qualify:llm": "esbuild qualifications/llm/qualify.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/llm-qualification.cjs && node out/llm-qualification.cjs",
    "qualify:living-presence": "esbuild qualifications/living-presence/soak.ts --bundle --platform=node --format=cjs --outfile=out/living-presence-soak.cjs && node out/living-presence-soak.cjs",
    "qualify:world-context": "esbuild qualifications/world-context/windows-worker.ts --bundle --platform=node --format=cjs --outfile=out/world-context-qualification.cjs && node out/world-context-qualification.cjs",
    "benchmark:latency": "npm run benchmark:latency-30",
    "benchmark:latency-30": "esbuild benchmarks/latency/benchmark.ts --bundle --platform=node --format=cjs --outfile=out/latency-30-benchmark.cjs && node out/latency-30-benchmark.cjs",
    "repro:continuous-listening": "esbuild scripts/continuous-listening-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/continuous-listening-repro.cjs && node out/continuous-listening-repro.cjs",
    "test:llm-live": "npm run qualify:llm",
    "qualify:speech-2d": "npm run build && esbuild qualifications/speech-2d/entry.ts --bundle --platform=browser --format=esm --outfile=out/renderer/qualification-speech-2d.mjs && node qualifications/speech-2d/qualify.cjs"
  },
  "keywords": [],
  "author": "lReSoNaNcEl",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
