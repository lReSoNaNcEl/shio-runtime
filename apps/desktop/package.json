{
  "name": "shio-runtime-desktop",
  "version": "0.1.0-alpha.6",
  "description": "Desktop AI character runtime with local speech integration.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "repro:playback": "esbuild scripts/speech-playback-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/speech-playback-repro.cjs && node out/speech-playback-repro.cjs",
    "repro:invariants": "esbuild scripts/runtime-invariant-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/runtime-invariant-repro.cjs && node out/runtime-invariant-repro.cjs",
    "repro:ear": "esbuild scripts/ear-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/ear-repro.cjs && node out/ear-repro.cjs",
    "repro:embodiment-polish": "esbuild scripts/embodiment-polish-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/embodiment-polish-repro.cjs && node out/embodiment-polish-repro.cjs",
    "repro:llm-compat": "esbuild scripts/llm-compat-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/llm-compat-repro.cjs && node out/llm-compat-repro.cjs",
    "repro:llm-live": "esbuild scripts/llm-live-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/llm-live-repro.cjs && node out/llm-live-repro.cjs",
    "repro:continuous-listening": "esbuild scripts/continuous-listening-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/continuous-listening-repro.cjs && node out/continuous-listening-repro.cjs",
    "repro:project-awareness": "esbuild scripts/project-awareness-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/project-awareness-repro.cjs && node out/project-awareness-repro.cjs",
    "repro:llm-credentials": "node node_modules/electron-vite/node_modules/esbuild/bin/esbuild scripts/llm-credential-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/llm-credential-repro.cjs && node out/llm-credential-repro.cjs",
    "repro:first-run": "node node_modules/electron-vite/node_modules/esbuild/bin/esbuild scripts/first-run-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/first-run-repro.cjs && node out/first-run-repro.cjs",
    "repro:localization": "esbuild scripts/localization-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/localization-repro.cjs && node out/localization-repro.cjs",
    "repro:screen-context-race": "node node_modules/electron-vite/node_modules/esbuild/bin/esbuild scripts/screen-context-race-repro/harness.ts --bundle --platform=node --format=cjs --external:electron --external:sharp --outfile=out/screen-context-race-repro.cjs && node out/screen-context-race-repro.cjs",
    "test:llm-live": "npm run repro:llm-live"
  },
  "keywords": [],
  "author": "lReSoNaNcEl",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@lezer/common": "^1.5.2",
    "@lezer/python": "^1.1.19",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@react-spectrum/s2": "^1.5.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "electron-log": "5.4.4",
    "electron-store": "^11.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "three": "0.185.1",
    "zod": "^4.4.3"
  }
}
