    "repro:plugin-runtime": "esbuild scripts/plugin-runtime-repro/harness.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/plugin-runtime-repro.cjs && node out/plugin-runtime-repro.cjs",
    "repro:llm-credentials": "node node_modules/electron-vite/node_modules/esbuild/bin/esbuild scripts/llm-credential-repro/harness.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/llm-credential-repro.cjs && node out/llm-credential-repro.cjs",
    "repro:first-run": "node node_modules/electron-vite/node_modules/esbuild/bin/esbuild scripts/first-run-repro/harness.ts --bundle --platform=node --format=cjs --outfile=out/first-run-repro.cjs && node out/first-run-repro.cjs",
