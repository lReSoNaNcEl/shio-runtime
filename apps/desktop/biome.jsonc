{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "../..",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },

  "files": {
    "ignoreUnknown": true,
    // Biome обслуживает только Desktop (эта директория). Python API (services/api) вне области.
    "includes": [
      "**",

      "!node_modules",
      "!out",
      "!runtime-debug",
      // Скомпилированные CJS-бандлы repro-харнессов: исходник — соседний .ts, файл не редактируется вручную.
      "!scripts/**/harness.cjs",
      // Бинарные VRM/VRMA и прочие ассеты рендерера.
      "!src/renderer/assets"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },

  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/shared/emotion/*"],
                "message": "Use the shared/emotion public entry point instead."
              },
              {
                "group": ["**/shared/llm/*"],
                "message": "Use the shared/llm public entry point instead."
              },
              {
                "group": ["**/shared/localization/messages/*"],
                "message": "Use the shared/localization/messages public entry point instead."
              },
              {
                "group": ["**/shared/project-awareness/*"],
                "message": "Use the shared/project-awareness public entry point instead."
              },
              {
                "group": ["**/shared/runtime/character-state/*"],
                "message": "Use the shared/runtime/character-state public entry point instead."
              }
            ]
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        }
      },
      "suspicious": {
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": true
          }
        }
      }
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":BLANK_LINE:", ":PACKAGE:", ":BLANK_LINE:", ":PATH:"]
          }
        }
      }
    }
  },

  "overrides": [
    {
      "includes": ["src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": {
              "level": "error",
              "options": {
                "checkTypes": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/components/**/*.{ts,tsx}", "src/renderer/hooks/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error"
          }
        }
      }
    }
  ]
}
