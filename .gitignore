# Secrets
.env
.env.*
!.env.example
!.env.release
*.key
*.pem
*.p12

# Node
node_modules/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Desktop builds
apps/desktop/dist/
apps/desktop/build/*
!apps/desktop/build/icon.ico
apps/desktop/out/
apps/desktop/release/
/release/

# Desktop runtime debug output (cwd-relative, regenerated at runtime)
apps/desktop/runtime-debug/

# Python environments and cache
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Python builds
apps/api/dist/
apps/api/build/

# API model storage
/apps/api/models/

# Runtime and temporary data
/logs/
/temp/
/tmp/
/apps/api/logs/
/apps/api/tmp/
*.log
*.pid

# Generated audio (do NOT blanket-ignore *.wav; voice reference wavs are handled by
# apps/api/.gitignore, which git-ignores them per upstream design)
*.generated.wav
*.temporary.wav
*.tmp.wav

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
